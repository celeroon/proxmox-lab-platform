# credentials and secrets
.env

# generated by setup.sh
setup.log

# per-deployment artifacts fetched from running VMs (regenerated each deploy)
data/artifacts/

# user-supplied custom detection rules — never pushed (keep the dir, ignore the rules).
# Sigma rules are NOT here: they are auto-cloned from SigmaHQ on elk-1 at build time.
data/rules/custom/*
!data/rules/custom/.gitkeep

# python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
dist/
build/
.pytest_cache/
.coverage
htmlcov/

# ansible
*.retry
ansible/collections/

# packer
packer_cache/
output-*/
*.qcow2

# database
*.sqlite
*.sqlite3

# os
.DS_Store
Thumbs.db

# internal session logs and notes
*.pid

# claude session files
.claude/

windows-vagrant/

*.ndjson