global:
  scrape_interval: 15s
  evaluation_interval: 15s

scrape_configs:
  - job_name: "prometheus"
    static_configs:
      - targets: ["localhost:9090"]

{% if elastic_nodes is defined and elastic_nodes %}
  - job_name: "elasticsearch"
    static_configs:
      - targets:
{% set _es_scrape = prometheus_es_targets | default(elastic_nodes) %}
{% for node in _es_scrape %}
          - "{{ node.ip }}:9114"
{% endfor %}
        labels:
          cluster: "{{ elk_cluster_name | default('lab-cluster') }}"
{% endif %}

{% if snmp_targets is defined and snmp_targets %}
  - job_name: "snmp"
    static_configs:
      - targets:
{% for t in snmp_targets %}
          - "{{ t.ip }}"
{% endfor %}
    metrics_path: /snmp
    params:
      module: ["{{ snmp_module | default('if_mib') }}"]
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
        regex: (.*)
        replacement: "{{ '${1}' }}"
      - target_label: __address__
        replacement: "localhost:9116"
{% endif %}
