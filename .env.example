# cp .env.example .env  →  fill in required values  →  sudo ./setup.sh

# ── Proxmox API (required) ────────────────────────────────────────────────────
# API token: Proxmox UI → Datacenter → Permissions → API Tokens → Add
# Token must belong to root@pam (e.g. root@pam!lab-token) — required for template import

# IP of the Proxmox node
PROXMOX_HOST=

# Proxmox web UI port (default: 8006)
PROXMOX_PORT=8006

# format: user@realm!token-name
PROXMOX_TOKEN_ID=

# UUID shown once at token creation
PROXMOX_TOKEN_SECRET=

# set to true if using a valid TLS certificate
PROXMOX_VERIFY_SSL=false

# Storage pool for VM disk images (not ISOs or backups).
# Leave empty to auto-detect: priority is Ceph RBD → ZFS pool → LVM-thin → first non-NFS pool.
# Override only if auto-detect picks the wrong pool or you have multiple pools of the same type.
# To find your pool name: Proxmox UI → Datacenter → Storage → look for "Disk image" in Content column.
#   Default fresh install (LVM-thin): local-lvm
#   ZFS root / RAID:                  local-zfs
#   Ceph:                             name varies (e.g. cephpool)
PROXMOX_STORAGE=

# VMID of the management VM itself. setup.sh creates it as 100 by convention —
# only set this if that VM was recreated under a different VMID (e.g. a manual
# reinstall that didn't reuse 100). Wrong value here means every "lab user create"
# silently hot-plugs the per-user NIC onto the wrong VM — DHCP for that user's VMs
# will never work, with no visible error at create time.
MGMT_VMID=

# ── Template storage ───────────────────────────────────────────────────────────
# Local directory on the management VM exported via NFS to all Proxmox nodes.
# Proxmox mounts this as the "nfs-templates" storage pool.
# Leave empty to use the default path.
TEMPLATES_DIR=/var/lib/lab-platform/templates

# Staging directory for vendor source files used by lab template build.
# Leave empty to use the default path.
BUILD_SOURCES_DIR=/var/lib/lab-platform/build-sources

# ── Database (auto-generated by setup.sh — leave empty) ──────────────────────

# full connection string — password is filled in by setup.sh
DB_URL=postgresql://lab:@localhost/lab

# generated by setup.sh
DB_PASSWORD=

# generated by setup.sh
SECRET_KEY=

# ── Cisco firewall (optional) ────────────────────────────────────────────────
FMC_SMART_TOKEN=
